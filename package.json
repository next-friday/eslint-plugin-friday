{
  "name": "@next-friday/eslint-plugin-friday",
  "version": "0.0.0",
  "description": "Next Friday-specific ESLint rules for shared engineering standards.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "react",
    "typescript",
    "next-friday"
  ],
  "homepage": "https://github.com/next-friday/eslint-plugin-friday#readme",
  "bugs": {
    "url": "https://github.com/next-friday/eslint-plugin-friday/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-friday/eslint-plugin-friday.git"
  },
  "license": "MIT",
  "author": "Next Friday",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "types": "./dist/index.d.mts",
    "import": "./dist/index.mjs",
    "default": "./dist/index.mjs"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "audit": "pnpm audit",
    "build": "tsdown",
    "changeset": "changeset",
    "changeset:status": "changeset status --since main",
    "check:attw": "attw --pack . --profile esm-only --ignore-rules cjs-resolves-to-esm --no-summary",
    "check:publint": "publint",
    "clean": "rm -rf dist coverage *.tsbuildinfo .eslintcache node_modules/.cache",
    "dev": "tsdown --watch",
    "docs:check": "pnpm build && eslint-doc-generator --check",
    "docs:generate": "pnpm build && eslint-doc-generator",
    "fix": "pnpm lint && pnpm format",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "knip": "knip",
    "lint": "eslint . --fix --cache --max-warnings=0",
    "lint:check": "eslint . --cache --max-warnings=0",
    "prepare": "husky",
    "sort-package-json": "sort-package-json package.json",
    "sort-package-json:check": "sort-package-json --check package.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm lint:check && pnpm format:check && pnpm sort-package-json:check && pnpm docs:check && pnpm typecheck && pnpm test:coverage && pnpm knip && pnpm build && pnpm check:publint && pnpm check:attw"
  },
  "dependencies": {
    "@eslint-react/core": "5.21.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-doc-generator": "3.7.1",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-package-json": "1.10.1",
    "eslint-plugin-unicorn": "76.0.0",
    "husky": "9.1.7",
    "knip": "6.38.0",
    "lint-staged": "17.6.0",
    "pkg-pr-new": "0.0.88",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "sort-package-json": "4.0.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
